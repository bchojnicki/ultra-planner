---
import Layout from "@/layouts/Layout.astro";
import PublicNav from "@/components/public/PublicNav.astro";
import { createClient } from "@/lib/supabase";
import { listPlans } from "@/lib/services/plans";
import PlanList from "@/components/plans/PlanList";
import type { Plan } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const plans: Plan[] = supabase ? await listPlans(supabase) : [];
---

<Layout title="Dashboard">
  <PublicNav />
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl text-white">
      <header class="mb-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Your plans
        </h1>
      </header>

      <form method="POST" action="/api/plans" class="mb-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium transition-colors hover:bg-white/20"
        >
          + New plan
        </button>
      </form>

      <PlanList plans={plans} client:load />
    </div>
  </div>
</Layout>
