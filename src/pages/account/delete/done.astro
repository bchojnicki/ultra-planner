---
import PublicLayout from "@/layouts/PublicLayout.astro";

// Goodbye page after a successful deletion (account-deletion). Public, static — the
// visitor's session has just been cleared, so there's nothing to gate.
---

<PublicLayout title="Account deleted">
  <div class="mx-auto flex min-h-[60vh] max-w-md flex-col justify-center px-4 py-16 text-center">
    <h1 class="text-2xl font-bold">Your account has been deleted</h1>
    <p class="text-haze/80 mt-4">
      Your account and all of your plans, aid stations, and gear have been permanently removed. Thanks for trying Ultra
      Planner.
    </p>
    <a href="/" class="text-haze/60 hover:text-haze mt-6 inline-block text-sm"> Back to home </a>
  </div>
</PublicLayout>
