---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getPlan } from "@/lib/services/plans";

// Read-only saved-plan view (S-04). Middleware gates /plans behind auth; the plan
// is loaded via the request-scoped client so RLS scopes it to the owner. The
// editable flow lives at /plans/[id]/edit. Phase 2 fills in the full read-only
// content (params, aid stations, gear, generated table); this is the shell.
const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!id || !supabase) return Astro.redirect("/dashboard");

const plan = await getPlan(supabase, id);
if (!plan) return Astro.redirect("/dashboard");
---

<Layout title={plan.name}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl text-white">
      <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Back to plans</a>
      <div class="mt-2 mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {plan.name}
        </h1>
        <a
          href={`/plans/${id}/edit`}
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium transition-colors hover:bg-white/20"
        >
          Edit plan
        </a>
      </div>
    </div>
  </div>
</Layout>
