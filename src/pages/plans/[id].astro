---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { loadPlanBundle } from "@/lib/services/plan-bundle";
import { computePlanTable } from "@/lib/plan-table";
import { computeAllocations } from "@/lib/gear-allocation";
import PlanSummary from "@/components/plans/PlanSummary.astro";
import AidStationList from "@/components/plans/AidStationList.astro";
import GearList from "@/components/plans/GearList.astro";
import PlanTable from "@/components/plans/PlanTable";

// Read-only saved-plan view (S-04). Middleware gates /plans behind auth; the plan
// is loaded via the request-scoped client so RLS scopes it to the owner. The
// editable flow lives at /plans/[id]/edit. The plan table + gear allocations are
// recomputed server-side from the persisted data (both are pure, deterministic),
// so the view renders as last generated without re-triggering generation.
const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!id || !supabase) return Astro.redirect("/dashboard");

const bundle = await loadPlanBundle(supabase, id);
if (!bundle) return Astro.redirect("/dashboard");
const { plan, stations, gearItems, gearSelections } = bundle;

const result = computePlanTable(plan, stations);
const allocations = computeAllocations(result, gearItems, gearSelections);
---

<Layout title={plan.name}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl text-white">
      <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Back to plans</a>
      <div class="mt-2 mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {plan.name}
        </h1>
        <a
          href={`/plans/${id}/edit`}
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium transition-colors hover:bg-white/20"
        >
          Edit plan
        </a>
      </div>

      <PlanSummary plan={plan} />
      <AidStationList stations={stations} />
      <GearList items={gearItems} />
      <PlanTable result={result} items={gearItems} allocations={allocations} readOnly />
    </div>
  </div>
</Layout>
