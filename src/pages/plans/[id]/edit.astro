---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { loadPlanBundle } from "@/lib/services/plan-bundle";
import PlanEditor from "@/components/plans/PlanEditor";

// Middleware gates /plans behind auth. Load the plan via the request-scoped
// client so RLS scopes it to the owner; a missing/non-owned id returns null.
const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!id || !supabase) return Astro.redirect("/dashboard");

const bundle = await loadPlanBundle(supabase, id);
if (!bundle) return Astro.redirect("/dashboard");
const { plan, stations, gearItems, gearSelections } = bundle;
---

<Layout title={plan.name}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-5xl text-white">
      <a href={`/plans/${id}`} class="text-sm text-purple-300 hover:underline">← Back to plan</a>
      <h1
        class="mt-2 mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
      >
        {plan.name}
      </h1>

      <PlanEditor
        plan={plan}
        initialStations={stations}
        initialGearItems={gearItems}
        initialSelections={gearSelections}
        client:load
      />
    </div>
  </div>
</Layout>
